{
  "name": "timeclock",
  "version": "2.0.0",
  "description": "Employee time clock kiosk + admin with SQLite, PDF and Excel exports",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-backup.js"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "2.37.3",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "supertest": "7.3.1"
  }
}
